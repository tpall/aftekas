process {
    
    withName: QC_RAW {
        ext.args   = '--quiet'
        ext.prefix = { "${meta.id}_raw" }
    }

    withName: FASTP {
         ext.args   = { [
            "-q ${params.fastp_qualified_quality}",
            "--cut_front",
            "--cut_tail",
            "--cut_mean_quality ${params.fastp_cut_mean_quality}",
            "--length_required ${params.reads_minlength}",
            params.fastp_trim_polyg ? "--trim_poly_g" : '',
            params.fastp_dedup ? "--dedup" : ''
        ].join(' ').trim() }
        ext.prefix = { "${meta.id}_fastp" }
    }

    withName: REMOVE_HOST {
        ext.prefix = { "${meta.id}_host_removed" } 
    }

    withName: REMOVE_PHIX {
        ext.prefix = { "${meta.id}_phix_removed" }
    }

    withName: QC_PREPROC {
        ext.args   = '--quiet'
        ext.prefix = { "${meta.id}_preproc" }
    }

    withName: MEGAHIT {
        ext.prefix = { "MEGAHIT_${meta.id}" }
    }

    // --meta is what makes this metaSPAdes. Without it SPAdes assumes a single genome
    // and the graph is not usable for a community.
    withName: SPADES {
        ext.args = '--meta'
        ext.prefix = { "metaSPAdes_${meta.id}" }
    }

    withName: METAQUAST {
        ext.args = { "--rna-finding --max-ref-number 0" }
    }

    // PILEUP, PRODIGAL and the four binners below all name their outputs from
    // meta.assembler. These prefixes used to be hardcoded 'MEGAHIT_', which was true
    // only while MEGAHIT was the only assembler: a --assembler spades run published
    // binning/bins/MEGAHIT_METABAT2_<id>.fa, a false provenance claim that then
    // travels into the Binette report, GTDB-Tk's user_genome and any samplesheet
    // built from this tree. meta.assembler reaches every one of them from the
    // assembly channel; assembly.nf fails the run if a join ever drops it.
    withName: PILEUP {
        ext.prefix = { "${meta.assembler}_${meta.id}" }
    }

    withName: PRODIGAL {
        ext.prefix = { "${meta.assembler}_PRODIGAL_${meta.id}" }
        ext.args = { "-p meta" }
    }

    withName: GET_ABUN {
        ext.prefix = { "${meta.id}_depths" }
    }

    // meta here comes from the assembly channel, so it carries the assembler. The BAM
    // is publishable (--save_bams) and its .bai must sit beside it under a matching
    // name, so the prefix has to be truthful about which assembler produced it.
    withName: SAMTOOLS_SORT {
        ext.prefix = { "${meta.assembler}_${meta.id}_sorted" }
    }

    withName: CONCOCT {
        ext.prefix = { "${meta.assembler}_CONCOCT_${meta.id}" }
    }

    withName: METABAT2 {
        ext.prefix = { "${meta.assembler}_METABAT2_${meta.id}" }
    }

    withName: MAXBIN2 {
        ext.prefix = { "${meta.assembler}_MAXBIN2_${meta.id}" }
    }

    withName: VAMB_BIN {
        ext.prefix = { "${meta.assembler}_VAMB_${meta.id}" }
        ext.args = { "-m 1000 --minfasta 50000" }
    }

    // Any single binner can legitimately fail on shallow/low-complexity samples
    // (e.g. MaxBin2 exits 255 when it finds too few marker genes). Ignore those
    // failures so the remaining binners still feed BINREFINE. Transient cluster
    // codes still get retried per the cluster profile.
    withName: 'CONCOCT|METABAT2|MAXBIN2|VAMB_BIN' {
        errorStrategy = { task.exitStatus in ((130..145) + 104 + 175) ? 'retry' : 'ignore' }
    }

    // DIAMOND can return zero hits on very low-complexity assemblies
    // (exit 3). Treat those as "sample failed refinement" rather than
    // aborting the whole run; transient cluster codes still retry.
    withName: BINETTE {
        errorStrategy = { task.exitStatus in ((130..145) + 104 + 175) ? 'retry' : 'ignore' }
    }

    withName: CLASSIFY {
        ext.args = { [
            params.gtdbtk_skip_ani_screen ? "--skip_ani_screen" : "",
            "--extension gz",
            "--pplacer_cpus ${params.pplacer_cpus}"
            ].join(' ').trim() }
        // Append an external `ps` to the gtdbtk container PATH when configured.
        // The ecogenomic/gtdbtk image lacks procps, which makes the singularity
        // metrics wrapper abort before gtdbtk runs. See params.gtdbtk_procps_bin.
        // A closure, not a plain expression: a plain one is evaluated while this file is read,
        // when the param still holds its default, so a value set in a -c file afterwards never
        // reaches the container and gtdbtk dies on the missing `ps` with the param apparently set.
        containerOptions = { params.gtdbtk_procps_bin ? "--env APPEND_PATH=${params.gtdbtk_procps_bin}" : null }
    }

}
