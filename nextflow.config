manifest {
    name            = 'tpall/aftekas'
    author          = """Taavi Päll"""
    homePage        = 'https://github.com/tpall/aftekas'
    description     = """Minimal metagenomic analysis workflow using slurm array"""
    mainScript      = 'main.nf'
    nextflowVersion = '!>=25.10.0'
    version         = 'v0.1.dev'
    doi             = ''
}

plugins {
  id 'nf-schema@2.8.0'
}

// Coerce CLI string params to their declared types (e.g. --array_size 20 → int,
// --fastp_dedup true → bool). Without this, nf-schema 2.x rejects CLI ints/bools
// as strings ("Value is [string] but should be [integer/boolean]").
validation {
  lenientMode = true
}

includeConfig 'conf/modules.config'
includeConfig 'conf/base.config'
workflow.output.mode = 'copy'

params {

    container_engine = 'docker' 
    singularity_pull_docker_container = true
    enable_conda = false

    input = 'samples.csv'
    
    reads_minlength = 15
    fastp_save_trimmed_fail = false
    fastp_qualified_quality = 15
    fastp_cut_mean_quality = 15
    fastp_trim_polyg = false
    fastp_dedup = false

    phix_accession = 'NC_001422.1'
    phix_reference = null
    host_index_url = 'https://objectstorage.uk-london-1.oraclecloud.com/n/lrbvkel2wjot/b/human-genome-bucket/o/human-t2t-hla.argos-bacteria-985_rs-viral-202401_ml-phage-202401.tar'
    host_fasta_url = 'https://objectstorage.uk-london-1.oraclecloud.com/n/lrbvkel2wjot/b/human-genome-bucket/o/human-t2t-hla.argos-bacteria-985_rs-viral-202401_ml-phage-202401.fa.gz'

    gtdbtk_db = 'databases/release220/'
    // The ecogenomic/gtdbtk image ships without `ps` (procps); under singularity
    // Nextflow's metrics wrapper aborts before gtdbtk runs. Set this to a directory
    // containing procps-ng's `ps` (e.g. `conda create -p <env> -c conda-forge procps-ng`
    // then point here at `<env>/bin`) to append it to the container PATH. null = off.
    gtdbtk_procps_bin = null
    use_pplacer_scratch_dir = false // Set to true to reduce pplacer memory usage by writing to disk (slower)
    pplacer_cpus = 1
    checkm2_db = 'databases/CheckM2_database/uniref100.KO.1.dmnd'

    // Read-based profiling (sylph vs GTDB). Off by default: it needs a ~14 GB
    // database that a plain MAG run has no use for.
    profile_reads = false
    skip_assembly = false
    sylph_db      = null                 // e.g. databases/sylph/gtdb-r226-c200-dbv2.syl2db
    sylph_tax_dir = null                 // from `sylph-tax download --download-to <dir>`; null = fetch in-task (~50 MB)
    sylph_tax_id  = 'GTDB_r226'          // sylph-tax taxonomy id; must match the release sylph_db was built from

}

// Execution reports. The 26.x strict config parser doesn't expose `workflow`
// (or top-level timestamp defs) here, so names are static; overwrite = true
// stops the "file already exists" warning on re-runs/-resume. For per-run
// history, pass -with-trace/-with-report/-with-timeline from the launcher with
// a shell-expanded name (e.g. logs/trace-${SLURM_JOB_ID}.txt) — CLI flags
// override these blocks.
trace {
    enabled   = true
    overwrite = true
    file      = "logs/trace.txt"
}

report {
    enabled   = true
    overwrite = true
    file      = "logs/report.html"
}

timeline {
    enabled   = true
    overwrite = true
    file      = "logs/timeline.html"
}
