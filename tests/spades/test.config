// Resources for the small SPAdes wiring test. The real labels ask for 12 cpus and
// 72 GB, which on a 500k-pair subsample only buys a long queue wait.
process {
    withName: SPADES          { cpus = 4; memory = 24.GB; time = 3.h }
    withName: FIX_FASTA_HEADER { cpus = 2; memory = 8.GB;  time = 1.h }
    withName: ALIGN           { cpus = 4; memory = 16.GB; time = 2.h }
    withName: SAMTOOLS_SORT   { cpus = 2; memory = 8.GB;  time = 1.h }
    withName: PILEUP          { cpus = 2; memory = 8.GB;  time = 1.h }
}
